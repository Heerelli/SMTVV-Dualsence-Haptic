; Reference table only - the forwarders are emitted by #pragma comment(linker) in dllmain.cpp.
; SMT5V DualSense haptic bridge.
; Every export is forwarded to the original mod, renamed to SMT5VHapticsCore.dll.
; Names and ordinals mirror SMT5V Haptics v0.6 exactly.
LIBRARY xinput1_3
EXPORTS
    XInputGetState=SMT5VHapticsCore.XInputGetState @2
    XInputSetState=SMT5VHapticsCore.XInputSetState @3
    XInputGetCapabilities=SMT5VHapticsCore.XInputGetCapabilities @4
    XInputEnable=SMT5VHapticsCore.XInputEnable @5
    XInputGetDSoundAudioDeviceGuids=SMT5VHapticsCore.XInputGetDSoundAudioDeviceGuids @6
    XInputGetBatteryInformation=SMT5VHapticsCore.XInputGetBatteryInformation @7
    XInputGetKeystroke=SMT5VHapticsCore.XInputGetKeystroke @8
    SMT5VHapticsPoCStatus=SMT5VHapticsCore.SMT5VHapticsPoCStatus @9
    SMT5VHapticsEventNormal=SMT5VHapticsCore.SMT5VHapticsEventNormal @10
    SMT5VHapticsEventCritical=SMT5VHapticsCore.SMT5VHapticsEventCritical @11
    SMT5VHapticsEventWeak=SMT5VHapticsCore.SMT5VHapticsEventWeak @12
    SMT5VHapticsEventSound=SMT5VHapticsCore.SMT5VHapticsEventSound @13
    SMT5VHapticsEventGuard=SMT5VHapticsCore.SMT5VHapticsEventGuard @14
    SMT5VHapticsEventHeal=SMT5VHapticsCore.SMT5VHapticsEventHeal @15